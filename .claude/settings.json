{
    "hooks": {
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/context-switcher.sh\"",
                        "statusMessage": "Loading relevant context",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/run-tests-hook.sh\"",
                        "statusMessage": "Running unit tests",
                        "timeout": 120
                    }
                ]
            }
        ]
    }
}
